# machine-local state — never committed (ARCHITECTURE §3.1)
.aos/
# …except the lint selftest's planted violation, which must exist in CI checkouts
# for the overlay/state-dir check to prove itself against it
!tools/lint/selftest/fixture/.aos/
# …and golden snapshots, which record the rendered user side incl. its lockfile
!tests/golden/**/.aos/

# NOTE on MOD.md / kb-registry.yaml (the overlay family): with the household layout
# (RFC-005 resolved) they live in the user's ~/aos/personal repo, never in this
# clone — so there is nothing to ignore. Upstream CI rejects overlay-family paths
# in PRs regardless (fixtures and golden snapshots are the one exemption).

# build tooling + scratch test area
node_modules/
tests/.sandbox/
__pycache__/
*.pyc
*.swp

# local harness/tooling state — never kit content
.agents/
.claude/
skills-lock.json
